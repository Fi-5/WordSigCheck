<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- net48 + Functions: drž to jednoduché -->
    <LangVersion>latest</LangVersion>

    <!-- ImplicitUsings/Nullable jsou pro net48 spíš zdroj bordelu -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Isolated worker -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.51.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" OutputItemType="Analyzer" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />

    <!-- Telemetrie -->
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.50.0" />

    <!-- Potřebuješ pro PackageDigitalSignatureManager -->
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- DŮLEŽITÉ: net48 nesmí tahat ASP.NET Core / WPF -->
  <ItemGroup>
    <!-- nic -->
  </ItemGroup>
</Project>
